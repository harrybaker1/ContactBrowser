<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ContactFragment">

    <LinearLayout
        android:id="@+id/headerLinearLayout"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/contactConstraintLayout"
        android:background="@color/secondary_blue"
        android:layoutDirection="rtl"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/delete"
            android:scaleType="fitCenter"
            android:layout_marginRight="10dp"></ImageButton>
        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/edit"
            android:scaleType="fitCenter"
            android:layout_marginRight="10dp"></ImageButton>
        <ImageButton
            android:id="@+id/saveButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/check"
            android:scaleType="fitCenter"
            android:layout_marginRight="10dp"></ImageButton>
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/previous"
            android:scaleType="fitCenter"
            android:layout_marginRight="10dp"></ImageButton>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contactConstraintLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary_blue"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLinearLayout">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewContact"
            android:layout_width="112dp"
            android:layout_height="112dp"
            app:cardCornerRadius="100dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="12dp"
            android:layout_centerVertical="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/name"
            android:layout_marginTop="24dp"
            >

            <androidx.cardview.widget.CardView
                android:layout_width="108dp"
                android:layout_height="108dp"
                app:cardCornerRadius="250dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/profilePicture"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:src="@drawable/default_profile"
                    android:scaleType="centerCrop"
                    />
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
        <ImageButton
            android:id="@+id/cameraButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/camera"
            android:scaleType="fitCenter"
            app:layout_constraintLeft_toRightOf="@id/cardViewContact"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/name"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="24dp"></ImageButton>
        <EditText
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="68dp"
            app:layout_constraintTop_toBottomOf="@id/cardViewContact"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/numberLayout"
            android:text="Name"
            android:textColor="@color/white"
            android:textSize="40dp"
            android:gravity="center"
            android:maxLength="18"
            ></EditText>
        <LinearLayout
            android:id="@+id/numberLayout"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/name"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@drawable/rounded_button"
            android:gravity="center">
            <TextView
                android:layout_width="270dp"
                android:layout_height="30dp"
                android:text="Phone Number"
                android:textColor="@color/gray"
                android:textSize="14dp"
                android:gravity="center_vertical"
                android:layout_marginLeft="12dp"
                ></TextView>

            <EditText
                android:id="@+id/number"
                android:layout_width="270dp"
                android:layout_height="40dp"
                android:text="123456789"
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:maxLength="28"
                android:layout_marginLeft="12dp"></EditText>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/emailLayout"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/numberLayout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_button"
            android:gravity="center">
            <TextView
                android:layout_width="270dp"
                android:layout_height="30dp"
                android:text="Email"
                android:textColor="@color/gray"
                android:textSize="14dp"
                android:gravity="center_vertical"
                android:layout_marginLeft="12dp"
                ></TextView>

            <EditText
                android:id="@+id/email"
                android:layout_width="270dp"
                android:layout_height="40dp"
                android:text="email@emailaddress.com"
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:maxLength="28"
                android:layout_marginLeft="12dp"></EditText>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/addressLayout"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/emailLayout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_button"
            android:gravity="center">
            <TextView
                android:layout_width="270dp"
                android:layout_height="30dp"
                android:text="Address"
                android:textColor="@color/gray"
                android:textSize="14dp"
                android:gravity="center_vertical"
                android:layout_marginLeft="12dp"
                ></TextView>

            <EditText
                android:id="@+id/address"
                android:layout_width="270dp"
                android:layout_height="40dp"
                android:enabled="false"
                android:text="Address"
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:maxLength="28"
                android:layout_marginLeft="12dp"></EditText>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>